@mode(host.dual)

# Top level of shuf: parse the arguments, report a command-line error,
# handle --help and --version, run the command, and turn an exception into
# status 1.
#
# Runtime: host.dual. Compiled into the native binary build/shuf by `make
# build`; `loup run source/main.loup` interprets the same code, and the
# unit tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE);
from cli.args import (Options, ArgError, parse_args);
from cli.usage import (usage, version_line);
from commands.shuf import (run_shuf);

# Parses argv, runs shuf and returns the exit status.
pub func run(argv: list[string]): int {
    var opts = Options();
    match parse_args(argv) {
        Ok(parsed) => { opts = parsed; },
        Err(e) => { return report(e); },
    }
    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    try {
        return run_shuf(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_FAILURE;
    }
}

func report(e: ArgError): int {
    printErr(APP_NAME + ": " + e.message);
    if (e.try_help) {
        printErr(i"Try '{$ APP_NAME $} --help' for more information.");
    }
    return EXIT_FAILURE;
}
